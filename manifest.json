{
  "manifest_version": 3,
  "name": "Gemini 画像一括ダウンローダー",
  "version": "1.0.1",
  "description": "Google Gemini (gemini.google.com) のチャット画面に表示された生成画像をワンクリックでまとめてダウンロードします。",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Gemini画像一括ダウンローダー"
  },

  "permissions": [
    "downloads",
    "scripting",
    "activeTab"
  ],

  "host_permissions": [
    "https://gemini.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
